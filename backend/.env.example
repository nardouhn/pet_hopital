# Database
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=example
PGDATABASE=vet_clinic

# Server
# In production set FRONTEND_URL to your frontend origin (e.g. http://example.com or http://<ip>:5173)
# If not set, the app will accept any http(s) origin to avoid accidental CORS blocks in deployed environments.
PORT=8080
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_secret

# Email
EMAIL_ID=
GOOGLEKEY=
